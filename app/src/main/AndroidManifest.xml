<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Wi-Fi scan results show where you are, so Android hands them only to apps with the precise location permission. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Needed to start a scan; Aegis never joins or changes a network. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <!-- For map tiles only: no scan data ever leaves the phone. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Bluetooth trackers (v2). Not marked neverForLocation: Aegis does use where a device was heard, and with that flag Android leaves some beacons out of the results. -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" />

    <!-- A notification when a device starts following you (v2); asked for on Android 13 and later. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <uses-feature android:name="android.hardware.wifi" android:required="true" />
    <!-- Wi-Fi scanning still works on a phone without Bluetooth LE. -->
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="false" />
    <!-- The compass that points to a device you are looking for (v2); scanning works without it. -->
    <uses-feature android:name="android.hardware.sensor.compass" android:required="false" />

    <application
        android:name=".AegisApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Aegis">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Opened by Aegis itself with an explicit intent; no other app can start it. -->
        <activity
            android:name=".ui.detail.DeviceDetailActivity"
            android:exported="false" />

        <!-- The search for one Bluetooth device, opened from its page. -->
        <activity
            android:name=".ui.find.FindActivity"
            android:exported="false" />
    </application>

</manifest>
